{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Token-Man",
  "version": "1.0.0",
  "identifier": "dev.tokenman.app",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Token-Man",
        "width": 540,
        "height": 280,
        "minWidth": 420,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": false,
        "skipTaskbar": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/Token-Man/*", "$RESOURCE/assets/*"]
      }
    }
  },
    "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["assets/*"],
    "category": "DeveloperTool",
    "shortDescription": "HUD for Claude token usage",
    "longDescription": "Token-Man unifies visibility into Claude token usage across Claude Code, claude.ai, Cowork, Chrome, Excel, and direct API workloads. It really whips the token's ass."
  }
}
